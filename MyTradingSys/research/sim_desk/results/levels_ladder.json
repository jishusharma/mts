{
 "id": "levels_ladder",
 "kind": "backtest",
 "parity": null,
 "family": "Price levels",
 "title": "Levels ladder (bounce at key levels)",
 "what": [
  {
   "name": "Idea",
   "value_plain": "When price first touches a key level in a day (4h swing highs and lows, untested volume peaks, yesterday's high, low and volume peak, last week's high, round thousands), bet that it bounces.",
   "label": "OURS"
  },
  {
   "name": "Timeframe / market",
   "value_plain": "BTCUSDT, 5-minute candles for the filter, 1-minute for fills",
   "label": "OURS"
  },
  {
   "name": "Entry filter",
   "value_plain": "Only if the 14-period RSI on 5-minute candles still reads above 40 for a long, below 60 for a short.",
   "label": "OURS"
  },
  {
   "name": "Entry style",
   "value_plain": "Do not buy at the touched level: place the whole order at the next level beyond it, against the trade. If price never gets there the idea is never filled.",
   "label": "OURS"
  },
  {
   "name": "Stop",
   "value_plain": "0.10 % past the day's extreme so far (pushed past the deeper level if needed).",
   "label": "OURS"
  },
  {
   "name": "Exit",
   "value_plain": "Take profit at the first level in favour (target 1), or at twice the stop distance, whichever the rule picks.",
   "label": "OURS"
  },
  {
   "name": "Fees",
   "value_plain": "0.02 % for resting orders, 0.05 % for stops and market exits. No slippage.",
   "label": "SOURCED"
  },
  {
   "name": "How the rule was picked",
   "value_plain": "Best of 240 variants on DEV (needs at least 200 ideas), so the number is flattering by construction.",
   "label": "OURS"
  }
 ],
 "how": "Every idea in DEV is replayed minute by minute with the rule above. Only ideas that actually filled count as trades. Results are in R (one R = the planned loss of that trade) after fees.",
 "window": "DEV only, 2022-04-01 to 2024-06-30 (sealed VALIDATION and HOLDOUT windows were not read)",
 "verdict": {
  "label": "Does not pay: FAIL",
  "tone": "bad"
 },
 "why": [
  "Fees eat the edge. Before fees the rule earns +0.217 R per filled trade; fees cost 0.337 R. Net -0.119 R per trade.",
  "104 of 255 filled trades won (40.8 %). The best single trade is +1.97 R, the worst -1.70 R, and the deepest losing run is 40.3 R.",
  "The rule is the best of 240 tries, which flatters it, and it is still below zero.",
  "517 of 772 ideas never filled (price never reached the deeper entry). They are not trades and are left out of every number above.",
  "The 'power' figures in the frozen rule file were computed over all 772 ideas including unfilled ones, so they are not repeated here.",
  "Default: park the idea. Nothing is read on VALIDATION."
 ],
