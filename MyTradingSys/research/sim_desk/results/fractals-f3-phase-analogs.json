{
 "id": "fractals-f3-phase-analogs",
 "kind": "backtest",
 "parity": null,
 "family": "Fractals + BTC phase",
 "provenance": "exported",
 "title": "Nearest-neighbour analog forecast on 1h BTC, with and without matching the market phase",
 "date": "2026-10-31",
 "what": [
  {
   "name": "Idea",
   "value_plain": "Find the 10 past 48-hour price shapes most like now (z-scored), and trade the next 24 hours the way they went if 70 % or more agree.",
   "label": "OURS"
  },
  {
   "name": "Query / library",
   "value_plain": "48 hourly bars; the library expands from about 83 days (2000 windows warm-up); neighbours at least 48 bars apart",
   "label": "OURS"
  },
  {
   "name": "Neighbours / agreement",
   "value_plain": "k = 10, agreement at least 70 %",
   "label": "OURS"
  },
  {
   "name": "Phase variant",
   "value_plain": "Neighbours must share the Cowen-side and 200-day-side tag of the query day",
   "label": "OURS"
  },
  {
   "name": "Hold / queries",
   "value_plain": "24 hours; 1,190 non-overlapping queries, split A and B at 2023-11-13",
   "label": "OURS"
  },
  {
   "name": "Fees",
   "value_plain": "Taker both legs, 0.10 % round trip; no slippage",
   "label": "SOURCED"
  },
  {
   "name": "Controls",
   "value_plain": "Random-walk surrogate libraries and block-shuffled outcomes, 300 draws each; Holm over 4 tests; week-block bootstrap 95 % CI",
   "label": "OURS"
  }
 ],
 "how": "For each non-overlapping query the nearest past shapes vote on direction; when 70 % agree a 24-hour trade is taken and charged the round trip. The same procedure on random-walk libraries and on shuffled outcomes gives the luck range. Single k, agreement and horizon: no tuning, by design.",
 "window": "DEV 2022-01-01 to 2025-06-30 (files after 2025-06 never opened; HOLDOUT untouched)",
 "verdict": {
  "label": "No edge: both variants inconclusive and below both controls (honest negative, underpowered to prove a loss)",
  "tone": "warn"
 },
 "why": [
  "Unfiltered: 368 trades, net -0.216 % per trade, hit rate 47.3 % (a coin flip pays the 0.10 % round trip).",
  "Phase-matched: 359 trades, net -0.277 % per trade. The phase tag halves the usable library and adds nothing (difference -0.061 %, CI -0.371 to +0.234).",
  "Both are below the random-walk and shuffled controls (p 0.80 to 0.92); Holm-adjusted p is 1.00.",
  "Split A -0.51 versus B +0.07 is the sign of noise: per-trade sd is 2.7 %, so 0.10 % needs about 5,900 trades and this study has 368.",
  "The CI straddles zero, so FAIL is not triggered. No rule, gate or layer added. The replay below shows net percent per trade."
 ],
