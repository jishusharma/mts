 PROMOTED_SETUPS = _ROOT / "MyTradingSys" / "execution" / "promoted_setups.json"
+LAYER_PARAMS_ROOT = _ROOT / "MyTradingSys" / "backtest" / "layers"
+
+def load_layer_exits(layer: str, sub: str | None) -> dict:
+    """Load the reviewed per-layer params document; absent/invalid exits reject closed."""
+    # Resolver must enumerate each traded family/subfamily and its canonical params file.
+    # It must never build a path from untrusted alert text or select a default bracket.
+    param_path = LAYER_PARAMS_FILES.get((layer, sub))
+    if param_path is None:
+        raise ValueError(f"no params file registered for {layer}:{sub}")
+    try:
+        doc = json.loads(param_path.read_text(encoding="utf-8"))
+        exits = doc["exits"]
+        stop = float(exits["stop_pct"])
+        targets = exits["targets"]
+        max_hold_bars = int(exits["max_hold_bars"])
+        if not (0 < stop < 100) or not targets or max_hold_bars <= 0:
+            raise ValueError("invalid exit bounds")
+        return {"stop_pct": stop, "targets": targets,
+                "max_hold_bars": max_hold_bars,
+                "bracket_source": f"params:{param_path.relative_to(_ROOT)}"}
+    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
+        raise ValueError(f"missing or invalid exits for {layer}:{sub}: {exc}") from exc
