+from MyTradingSys.execution.auto_trader import layer_signal
+
+
+def _signal(alert):
+    # Minimal shape used by layer_signal before its later policy checks.
+    cfg = {"layers": {"enabled": True}, "disabled_layers": set(),
+           "layer_rules": {"rsi:cross": "short", "rsi:support": "long"}}
+    from datetime import datetime, timezone
+    return layer_signal(alert, cfg, datetime.now(timezone.utc))
+
+
+def test_cross_with_valid_side_fails_closed_before_promotion_check():
+    # Fail-first: before the gate, this alert proceeds to promotion policy;
+    # after the gate it is rejected specifically as untested.
+    sig = _signal({"layer": "rsi", "tf": "1h", "event": "cross",
+                   "level_value": 40, "tolerance_used": 0.5,
+                   "side": "short", "t_close": 1_800_000_000_000})
+    assert sig["reject"] == "untested RSI event (fail closed)"
+
+
+def test_only_exact_studied_tuple_passes_coverage_gate():
+    from MyTradingSys.execution.auto_trader import rsi_event_tested
+    assert rsi_event_tested({"tf": "1h", "event": "support", "level_value": 40,
+                             "tolerance_used": 0.5})
+    assert not rsi_event_tested({"tf": "15m", "event": "support", "level_value": 40,
+                                "tolerance_used": 0.5})
+    assert not rsi_event_tested({"tf": "1h", "event": "failure"})