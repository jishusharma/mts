{
  "_note": "ONE place for tasks every device must do. Edit with scripts/dev/device_tasks.py add (adds + announces). See DEVICE_TASKS.md.",
  "devices": ["JIS-DESKTOP", "JIS-LAPTOP", "JIS-NUC", "vm"],
  "tasks": [
    {
      "id": "primary-checkout-current",
      "what": "Primary checkout is within 50 commits of origin/fast-track (stale hooks and scripts otherwise).",
      "run": "git -C <primary checkout> pull --ff-only origin fast-track",
      "verify": "python scripts/dev/device_tasks.py probe behind 50",
      "applies_to": ["JIS-DESKTOP", "JIS-LAPTOP", "JIS-NUC"],
      "added": "2026-10-26",
      "by_hook": "manual (broadcast b-4c2dfe line, step 1)"
    },
    {
      "id": "c-guard-logon",
      "what": "Logon cleanup: HKCU Run value MTSTempGuard prunes the %TEMP% set at each logon (no scheduler).",
      "run": "python scripts/dev/c_drive_guard.py install",
      "verify": "python scripts/dev/c_drive_guard.py status --check",
      "applies_to": ["JIS-DESKTOP", "JIS-LAPTOP", "JIS-NUC"],
      "added": "2026-10-24",
      "by_hook": "manual once; then runs itself at logon"
    },
    {
      "id": "wt-maint",
      "what": "Worktree maintenance task MTS-WorktreeMaint-<device> (the one allowed standing task, SCHEDULING_POLICY s4b).",
      "run": "python scripts/dev/wt_maint.py install",
      "verify": "python scripts/dev/wt_maint.py status",
      "applies_to": ["JIS-DESKTOP", "JIS-LAPTOP", "JIS-NUC"],
      "added": "2026-10-21",
      "by_hook": "c_drive_guard daily SessionStart also runs wt_maint --apply --no-log"
    },
    {
      "id": "disk-free-15gb",
      "what": "System drive has at least 15 GB free.",
      "run": "python scripts/dev/c_drive_guard.py --apply",
      "verify": "python scripts/dev/device_tasks.py probe free-gb 15",
      "applies_to": "all",
      "added": "2026-10-28",
      "by_hook": "c_drive_guard daily SessionStart"
    },
    {
      "id": "no-stray-sched-tasks",
      "what": "No MTS-* scheduled task other than MTS-WorktreeMaint-* and MTS-CBP-Ingestion (SCHEDULING_POLICY s1).",
      "run": "Unregister-ScheduledTask -TaskName <name> -Confirm:$false",
      "verify": "python scripts/dev/device_tasks.py probe no-mts-tasks",
      "applies_to": ["JIS-DESKTOP", "JIS-LAPTOP", "JIS-NUC"],
      "added": "2026-10-17",
      "by_hook": "manual"
    },
    {
      "id": "live-owner-dir",
      "what": "Env MTS_LIVE_OWNER_DIR names the shared one-owner marker dir on BOTH live-capable hosts (DEVICES s3).",
      "run": "setx MTS_LIVE_OWNER_DIR \\\\JIS-NUC\\MTS-Live",
      "verify": "python scripts/dev/device_tasks.py probe env MTS_LIVE_OWNER_DIR",
      "applies_to": ["JIS-DESKTOP", "JIS-LAPTOP"],
      "added": "2026-10-21",
      "by_hook": "manual (needs the NUC share MTS-Live, LIVE_HOST_MOVE s5)"
    },
    {
      "id": "git-recent",
      "what": "Git 2.40 or newer (laptop shipped with 2.24.1).",
      "run": "winget install --id Git.Git -e",
      "verify": "python scripts/dev/device_tasks.py probe git-min 2.40",
      "applies_to": ["JIS-LAPTOP"],
      "added": "2026-10-21",
      "by_hook": "manual"
    }
  ]
}
