# test_mts_math.py — Unit tests for mts_math.py
# Requirements: pytest
# Run: pytest mts/tests/test_mts_math.py -v

import sys
from pathlib import Path

# Add runtime to path
sys.path.insert(0, str(Path(__file__).parent.parent / "runtime"))

from mts_math import (
    calculate_distance,
    get_zone_substate,
    get_distance_cap,
    get_tier,
    check_trigger_validity,
    calculate_gross_rr,
    calculate_net_rr,
    calculate_rr_sanity,
    detect_confluence,
    parse_state,
    diff_state,
    update_state,
    format_state,
    write_state,
    _cast,
    _get_snapshot_value,
)


