# ============================================================
# TESTS: calculate_distance
# ============================================================

def test_distance_positive():
    assert calculate_distance(81000.0, 80000.0) == 0.0125

def test_distance_negative():
    assert calculate_distance(79000.0, 80000.0) == -0.0125

def test_distance_zero():
    assert calculate_distance(80000.0, 80000.0) == 0.0

def test_distance_determinism():
    d1 = calculate_distance(81000.0, 80000.0)
    d2 = calculate_distance(81000.0, 80000.0)
    assert d1 == d2


# ============================================================
# TESTS: get_zone_substate
# ============================================================

def test_substate_at_zone():
    assert get_zone_substate(80080.0, 80000.0, fuzz=0.001) == "at_zone"

def test_substate_above_zone():
    assert get_zone_substate(80200.0, 80000.0, fuzz=0.001) == "above_zone"

def test_substate_below_zone():
    assert get_zone_substate(79800.0, 80000.0, fuzz=0.001) == "below_zone"

def test_substate_exact_threshold():
    assert get_zone_substate(80080.0, 80000.0, fuzz=0.001) == "at_zone"
    assert get_zone_substate(80081.0, 80000.0, fuzz=0.001) == "above_zone"


# ============================================================
# TESTS: get_distance_cap
# ============================================================

def test_cap_weekly():
    assert get_distance_cap("weekly_poc") == 0.005

def test_cap_daily():
    assert get_distance_cap("daily_vah") == 0.004

def test_cap_vwap():
    assert get_distance_cap("vwap_band") == 0.002

def test_cap_speed_doubles():
    assert get_distance_cap("daily_poc", speed_picking_up=True) == 0.008

def test_cap_unknown_default():
    assert get_distance_cap("unknown_zone") == 0.003

def test_cap_speed_unknown():
    assert get_distance_cap("unknown_zone", speed_picking_up=True) == 0.006


# ============================================================
# TESTS: get_tier
# ============================================================

def test_tier_trigger_ready():
    assert get_tier(0.0005, 0.004) == "trigger_ready"

def test_tier_conditional():
    assert get_tier(0.002, 0.004) == "conditional"

def test_tier_ignore():
    assert get_tier(0.005, 0.004) == "ignore"

def test_tier_exact_trigger_boundary():
    assert get_tier(0.001, 0.004) == "trigger_ready"

def test_tier_exact_cap_boundary():
    assert get_tier(0.004, 0.004) == "conditional"

def test_tier_negative_distance():
    assert get_tier(-0.0005, 0.004) == "trigger_ready"
    assert get_tier(-0.002, 0.004) == "conditional"
    assert get_tier(-0.005, 0.004) == "ignore"


# ============================================================
# TESTS: check_trigger_validity
# ============================================================

def test_ct_at_zone_valid():
    assert check_trigger_validity("at_zone", "ct_short") is True
    assert check_trigger_validity("at_zone", "ct_long") is True

def test_ct_not_at_zone_invalid():
    assert check_trigger_validity("above_zone", "ct_short") is False
    assert check_trigger_validity("below_zone", "ct_long") is False

def test_bo_break_valid():
    assert check_trigger_validity("above_zone", "bo_long") is True
    assert check_trigger_validity("below_zone", "bo_short") is True

def test_bo_at_zone_invalid():
    assert check_trigger_validity("at_zone", "bo_long") is False

def test_tc_at_zone_valid():
    assert check_trigger_validity("at_zone", "tc_long") is True

def test_scalp_at_zone_valid():
    assert check_trigger_validity("at_zone", "scalp") is True

def test_unknown_setup():
    assert check_trigger_validity("at_zone", "unknown") is False


# ============================================================
# TESTS: calculate_gross_rr
# ============================================================

def test_rr_basic():
    rr = calculate_gross_rr(79500.0, 80500.0, 79200.0)
    assert rr == 1000.0 / 300.0

def test_rr_short_direction():
    rr = calculate_gross_rr(80500.0, 79500.0, 80800.0)
    assert rr == 1000.0 / 300.0

def test_rr_division_by_zero():
    assert calculate_gross_rr(80000.0, 81000.0, 80000.0) == 0.0

def test_rr_zero_reward():
    assert calculate_gross_rr(80000.0, 80000.0, 79000.0) == 0.0


# ============================================================
# TESTS: calculate_net_rr
# ============================================================

def test_net_rr_default_friction():
    assert calculate_net_rr(4.0) == 3.0

def test_net_rr_custom_friction():
    assert calculate_net_rr(4.0, friction=0.10) == 3.6

def test_net_rr_zero():
    assert calculate_net_rr(0.0) == 0.0


# ============================================================
# TESTS: calculate_rr_sanity
# ============================================================

def test_sanity_pass():
    assert calculate_rr_sanity(2.0) is True
    assert calculate_rr_sanity(1.5) is True

def test_sanity_fail():
    assert calculate_rr_sanity(1.499999) is False
    assert calculate_rr_sanity(1.0) is False
    assert calculate_rr_sanity(0.0) is False

def test_sanity_custom_threshold():
    assert calculate_rr_sanity(2.0, threshold=2.5) is False
    assert calculate_rr_sanity(3.0, threshold=2.5) is True


# ============================================================
# TESTS: detect_confluence
# ============================================================

def test_confluence_two_zones():
    zones = [
        {"name": "POC", "price": 78000.0},
        {"name": "VWAP", "price": 78050.0},
    ]
    clusters = detect_confluence(zones, threshold=0.003)
    assert len(clusters) == 1
    assert set(clusters[0]["zones"]) == {"POC", "VWAP"}
    assert clusters[0]["midpoint"] == 78025.0
    assert clusters[0]["spread"] == 50.0

def test_confluence_three_zones():
    zones = [
        {"name": "A", "price": 78000.0},
        {"name": "B", "price": 78050.0},
        {"name": "C", "price": 77980.0},
    ]
    clusters = detect_confluence(zones, threshold=0.003)
    assert len(clusters) == 1
    assert len(clusters[0]["zones"]) == 3

def test_confluence_no_clusters():
    zones = [
        {"name": "A", "price": 78000.0},
        {"name": "B", "price": 80000.0},
    ]
    clusters = detect_confluence(zones, threshold=0.003)
    assert len(clusters) == 0

def test_confluence_empty_list():
    assert detect_confluence([]) == []

def test_confluence_single_zone():
    assert detect_confluence([{"name": "A", "price": 78000.0}]) == []

def test_confluence_two_separate_clusters():
    zones = [
        {"name": "A", "price": 78000.0},
        {"name": "B", "price": 78030.0},
        {"name": "C", "price": 80000.0},
        {"name": "D", "price": 80050.0},
    ]
    clusters = detect_confluence(zones, threshold=0.003)
    assert len(clusters) == 2


# ============================================================
# TESTS: parse_state
# ============================================================

def test_parse_state_basic(tmp_path):
    state_file = tmp_path / "test_state.md"
    state_file.write_text("""# CURRENT MARKET STATE
## META
updated_utc: 2026-08-31T14:49:16Z
asset: BTCUSDT

## WEEKLY
poc: 77922.02
vah: 78332.98

# END
""")
    state = parse_state(str(state_file))
    assert state["META"]["asset"] == "BTCUSDT"
    assert state["WEEKLY"]["poc"] == "77922.02"
    assert state["WEEKLY"]["vah"] == "78332.98"
    assert "END" not in state


def test_parse_state_empty_file(tmp_path):
    state_file = tmp_path / "empty.md"
    state_file.write_text("# EMPTY\n")
    state = parse_state(str(state_file))
    assert state == {}


# ============================================================
# TESTS: _cast
# ============================================================

def test_cast_bool_true():
    assert _cast("true") is True
    assert _cast("True") is True

def test_cast_bool_false():
    assert _cast("false") is False
    assert _cast("False") is False

def test_cast_float():
    assert _cast("3.14") == 3.14
    assert _cast("-2.5") == -2.5

def test_cast_string():
    assert _cast("B") == "B"
    assert _cast("hello") == "hello"


# ============================================================
# TESTS: _get_snapshot_value
# ============================================================

def test_get_snapshot_value_nested():
    snapshot = {"weekly_vp": {"poc": 77922.0, "vah": 78333.0}}
    assert _get_snapshot_value(snapshot, "weekly_vp.poc") == 77922.0
    assert _get_snapshot_value(snapshot, "weekly_vp.vah") == 78333.0

def test_get_snapshot_value_missing():
    snapshot = {"weekly_vp": {"poc": 77922.0}}
    assert _get_snapshot_value(snapshot, "weekly_vp.val") is None
    assert _get_snapshot_value(snapshot, "missing.path") is None


# ============================================================
# TESTS: diff_state
# ============================================================

def test_diff_state_no_change():
    old_state = {
        "META": {"last_price": "78000.0"},
        "WEEKLY": {"poc": "77922.02", "vah": "78332.98", "shape": "B"},
        "STATE": {"unchanged_count": "2"},
    }
    snapshot = {
        "current_price": 78000.0,
        "weekly_vp": {"poc": 77922.02, "vah": 78332.98, "shape": "B"},
    }
    delta = diff_state(old_state, snapshot)
    assert delta["changes"] == []
    assert delta["structural_change"] is False
    assert delta["state_transition"] is False
    assert delta["unchanged_count"] == 3
    assert delta["price_delta_pct"] == 0.0

def test_diff_state_price_change():
    old_state = {
        "META": {"last_price": "78000.0"},
        "WEEKLY": {"poc": "77922.02", "vah": "78332.98", "shape": "B"},
        "STATE": {"unchanged_count": "2"},
    }
    snapshot = {
        "current_price": 78410.0,
        "weekly_vp": {"poc": 77922.02, "vah": 78332.98, "shape": "B"},
    }
    delta = diff_state(old_state, snapshot)
    assert delta["price_delta_pct"] > 0.005  # ~0.53%
    assert delta["structural_change"] is False
    assert delta["unchanged_count"] == 3

def test_diff_state_structural_change():
    old_state = {
        "META": {"last_price": "78000.0"},
        "WEEKLY": {"poc": "77922.02", "vah": "78332.98", "shape": "B"},
        "STATE": {"unchanged_count": "2"},
    }
    snapshot = {
        "current_price": 78000.0,
        "weekly_vp": {"poc": 78000.0, "vah": 78332.98, "shape": "B"},
    }
    delta = diff_state(old_state, snapshot)
    assert delta["structural_change"] is True
    assert delta["unchanged_count"] == 0
    assert any(c["field"] == "WEEKLY.poc" for c in delta["changes"])

def test_diff_state_substate_change():
    old_state = {
        "META": {"last_price": "78200.0"},
        "WEEKLY": {"vah": "78332.98"},
        "STATE": {"unchanged_count": "0"},
    }
    snapshot = {
        "current_price": 78500.0,
        "weekly_vp": {"vah": 78332.98},
    }
    delta = diff_state(old_state, snapshot)
    # Old price 78200: dist = (78200-78332.98)/78332.98 = -0.17% -> below_zone
    # New price 78500: dist = (78500-78332.98)/78332.98 = +0.21% -> above_zone
    assert len(delta["substate_changes"]) == 1
    assert delta["substate_changes"][0]["zone"] == "WEEKLY.vah"
    assert delta["substate_changes"][0]["old_substate"] == "below_zone"
    assert delta["substate_changes"][0]["new_substate"] == "above_zone"
    assert delta["substate_changes"][0]["old_substate"] == "below_zone"
    assert delta["substate_changes"][0]["new_substate"] == "above_zone"


def test_diff_state_state_transition():
    old_state = {
        "META": {"last_price": "78000.0"},
        "STATE": {"classification": "D", "unchanged_count": "1"},
    }
    snapshot = {
        "current_price": 78000.0,
        "conditions": {"vp_shape": "B"},
    }
    delta = diff_state(old_state, snapshot)
    assert delta["state_transition"] is True
    assert any(c["field"] == "STATE.classification" for c in delta["changes"])


# ============================================================
# TESTS: update_state
# ============================================================

def test_update_state_basic():
    old_state = {
        "META": {"last_price": "78000.0"},
        "STATE": {"last_verdict": "C+ CT Short", "unchanged_count": "2"},
    }
    snapshot = {
        "timestamp_utc": "2026-08-31T14:49:16Z",
        "asset": "BTCUSDT",
        "current_price": 78410.0,
        "weekly_vp": {"poc": 77922.02, "vah": 78332.98, "val": 77656.41, "shape": "B"},
        "conditions": {"vp_shape": "B", "price_vs_va": "above_vah"},
    }
    new_state = update_state(old_state, snapshot)
    assert new_state["META"]["asset"] == "BTCUSDT"
    assert new_state["META"]["last_price"] == "78410.0"
    assert new_state["WEEKLY"]["poc"] == "77922.02"
    assert new_state["STATE"]["classification"] == "B"
    assert new_state["STATE"]["position"] == "above_vah"
    # last_verdict preserved
    assert new_state["STATE"]["last_verdict"] == "C+ CT Short"


def test_update_state_unchanged_count_reset():
    old_state = {
        "META": {"last_price": "78000.0"},
        "WEEKLY": {"poc": "77922.02"},
        "STATE": {"unchanged_count": "5"},
    }
    snapshot = {
        "current_price": 78000.0,
        "weekly_vp": {"poc": 78000.0},
    }
    new_state = update_state(old_state, snapshot)
    assert new_state["STATE"]["unchanged_count"] == "0"


def test_update_state_unchanged_count_increment():
    old_state = {
        "META": {"last_price": "78000.0"},
        "WEEKLY": {"poc": "77922.02"},
        "STATE": {"unchanged_count": "3"},
    }
    snapshot = {
        "current_price": 78000.0,
        "weekly_vp": {"poc": 77922.02},
    }
    new_state = update_state(old_state, snapshot)
    assert new_state["STATE"]["unchanged_count"] == "4"


# ============================================================
# TESTS: write_state
# ============================================================

def test_write_state_roundtrip(tmp_path):
    state = {
        "META": {"asset": "BTCUSDT", "last_price": "78410.0"},
        "WEEKLY": {"poc": "77922.02", "shape": "B"},
    }
    # Test format_state produces parseable output
    content = format_state(state)
    filepath = str(tmp_path / "roundtrip.md")
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(content)
    parsed = parse_state(filepath)
    assert parsed["META"]["asset"] == "BTCUSDT"
    assert parsed["WEEKLY"]["poc"] == "77922.02"
    assert parsed["WEEKLY"]["shape"] == "B"


# ============================================================
# DETERMINISM TESTS (all functions)
# ============================================================

def test_all_functions_deterministic():
    assert calculate_distance(81000.0, 80000.0) == calculate_distance(81000.0, 80000.0)
    assert get_zone_substate(80080.0, 80000.0) == get_zone_substate(80080.0, 80000.0)
    assert get_distance_cap("daily_poc", True) == get_distance_cap("daily_poc", True)
    assert get_tier(0.002, 0.004) == get_tier(0.002, 0.004)
    assert check_trigger_validity("at_zone", "ct_short") == check_trigger_validity("at_zone", "ct_short")
    assert calculate_gross_rr(79500.0, 80500.0, 79200.0) == calculate_gross_rr(79500.0, 80500.0, 79200.0)
    assert calculate_net_rr(4.0) == calculate_net_rr(4.0)
    assert calculate_rr_sanity(2.0) == calculate_rr_sanity(2.0)
    zones = [{"name": "A", "price": 78000.0}, {"name": "B", "price": 78050.0}]
    c1 = detect_confluence(zones)
    c2 = detect_confluence(zones)
    assert len(c1) == len(c2)
    assert c1[0]["midpoint"] == c2[0]["midpoint"]
    assert c1[0]["spread"] == c2[0]["spread"]
    assert c1[0]["zones"] == c2[0]["zones"]


# ============================================================
# EDGE CASE TESTS
# ============================================================

def test_edge_negative_distance():
    assert get_tier(-0.0005, 0.004) == "trigger_ready"

def test_edge_zone_price_zero():
    try:
        calculate_distance(80000.0, 0.0)
        assert False, "Should have raised ValueError"
    except ValueError:
        pass

def test_edge_confluence_unsorted_input():
    zones = [
        {"name": "B", "price": 78050.0},
        {"name": "A", "price": 78000.0},
    ]
    clusters = detect_confluence(zones, threshold=0.003)
    assert len(clusters) == 1
    assert clusters[0]["midpoint"] == 78025.0
