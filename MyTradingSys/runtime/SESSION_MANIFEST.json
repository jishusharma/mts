  {
   "path": "USER.md",
   "role": "user_preferences",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/runtime/BUILD_REPORT.md",
   "role": "build_status",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "DSA_SESSION_PROMPT.md",
   "role": "behavior_source",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/system/SURFACE_POLICY.md",
   "role": "surface_policy",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/PROJECT_VISION.md",
   "role": "direction_doctrine",
   "read": "pointer",
   "mode": "live_only",
   "read_was": "full"
  },
  {
   "path": "MyTradingSys/runtime/session_state.json",
   "role": "thesis_ssot",
   "read": "full",
   "mode": "live_only"
  },
  {
   "path": "MyTradingSys/runtime/current_market_state.md",
   "role": "structural_baseline",
   "read": "full",
   "mode": "live_only"
  },
  {
   "path": "MyTradingSys/runtime/state_code.json",
   "role": "tick_flow_state",
   "read": "full",
   "mode": "live_only"
  },
  {
   "path": "MyTradingSys/runtime/NEXT_SESSION_HANDOFF.md",
   "role": "mission",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/runtime/session_log.json",
   "role": "decision_ledger",
   "read": "skip",
   "mode": "live_only"
  }
 ],
 "boot_supplemental": [
  {
   "path": "MyTradingSys/research/BUGS.md",
   "role": "bug_list",
   "read": "pointer",
   "mode": "always",
   "read_was": "open_only"
  },
  {
   "path": "MyTradingSys/research/L_ITEMS_MASTER.md",
   "role": "history_frozen",
   "read": "skip",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/research/MTS_DICTIONARY.md",
   "role": "field_reference",
   "read": "sections",
   "mode": "live_only",
   "sections": [
    "CROSS-CATEGORY WARNINGS",
    "PLAIN LANGUAGE RULE",
    "CORE TERMS",
    "LIVE FEED NAMES",
    "VERDICT WORDS",
    "CONFIDENCE GRADES",
    "SOURCE TAGS"
   ]
  },
  {
   "path": "MyTradingSys/research/apparatus_fixes.md",
   "role": "fix_log",
   "read": "head_to_end",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/methodology/playbook.md",
   "role": "research_gate",
   "read": "part_I",
   "mode": "live_only"
  },
  {
   "path": "runtime_data/apparatus_log.txt",
   "role": "recent_cycles",
   "read": "tail",
   "lines": 60,
   "mode": "live_only"
  },
  {
   "path": "runtime_data/snapshots/",
   "role": "live_snapshot",
   "read": "latest_glob",
   "pattern": "BTCUSDT_*.json",
   "count": 1,
   "mode": "live_only"
  },
  {
   "path": "MyTradingSys/methodology/live_session_protocol.md",
   "role": "ai_checks",
   "read": "pointer",
   "mode": "always",
   "sections": [
    "OPERATIONAL CHECKS",
    "PROCESS SPEED RULES",
    "RULES 12-14"
   ],
   "read_was": "sections"
  },
  {
   "path": "MyTradingSys/runtime/live_session_journal.md",
   "role": "session_journal",
   "read": "tail",
   "lines": 60,
   "mode": "live_only"
  },
  {
   "path": "MyTradingSys/methodology/chart_read_protocol.md",
   "role": "chart_read_method",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "operator_reminders.md",
   "role": "operator_reminders",
   "read": "pointer",
   "mode": "live_only",
   "read_was": "full"
  },
  {
   "path": "MyTradingSys/items/INDEX.md",
   "role": "items_index",
   "read": "pointer",
   "mode": "always",
   "read_was": "full"
  },
  {
   "path": "Dumps/operator/context/DSA_HANDOFF.md",
   "role": "session_handoff",
   "read": "full",
   "mode": "always"
  },
  {
   "path": "MyTradingSys/system/LESSONS_LEARNED.md",
   "role": "lessons",
   "read": "tail",
   "lines": 40,
   "mode": "always"
  },
  {
   "path": "MyTradingSys/research/fast_track_2026-09-27/SUPERVISOR_INBOX.md",
   "role": "supervisor_inbox",
   "read": "pointer",
   "mode": "always"
  }
 ],
 "process_check": [
  "java"
 ],
 "handoff_required_fields": [
  "STATUS",
  "STATUS_NOTE"
 ]
}
