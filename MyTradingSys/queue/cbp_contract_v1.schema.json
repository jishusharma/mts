{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP -> MTS mts_queue pending.json entry, contract v1",
  "description": "CBP owns mts_queue/pending.json and writes entries. MTS writes mts_queue/acks/<id>.json and flips status only. Entries become CANDIDATES (never orders). Validated by MyTradingSys/queue/cbp_adapter.py.",
  "type": "object",
  "required": ["id", "queued_at", "source", "asset", "direction", "entry_trigger", "target", "invalidation", "status", "expires_at"],
  "properties": {
    "contract_version": {"const": 1, "description": "optional; absent means 1"},
    "id": {"type": "string"},
    "queued_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "required": ["analyst", "channel", "video_id", "publish_date"],
      "properties": {"analyst": {"type": "string"}, "channel": {"type": "string"}, "video_id": {"type": "string"}, "publish_date": {"type": "string"}}
    },
    "asset": {"type": "string"},
    "direction": {"enum": ["LONG", "SHORT"]},
    "entry_trigger": {"type": "string", "description": "analyst's words"},
    "target": {"type": "object"},
    "invalidation": {"type": "string", "description": "analyst's words"},
    "stop_loss": {},
    "status": {"enum": ["pending", "consumed", "rejected"]},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
