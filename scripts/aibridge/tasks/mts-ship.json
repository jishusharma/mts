{
  "name": "mts-ship",
  "description": "Ship the work tree to fast-track (sync.py ship runs its own smoke gate), then confirm nothing is left unshipped",
  "params": { "repo": "C:\\Users\\E-ngineers\\IdeaProjects\\mts-dsa", "release": null },
  "steps": [
    { "name": "status", "cmd": "git status -sb", "cwd": "{repo}", "show": 8 },
    { "name": "ship", "cmd": "python scripts/dev/sync.py ship --release {release}", "cwd": "{repo}", "timeout_s": 1100, "show": 12 },
    { "name": "where", "cmd": "python scripts/dev/sync.py where", "cwd": "{repo}", "timeout_s": 120, "show": 4 }
  ]
}