# --- Python ---
__pycache__/
*.py[cod]
*.new

# --- IDE ---
.idea/
*.iml

# --- Maven ---
target/

# --- Runtime data (regenerable) ---
runtime_data/snapshots/*.json
runtime_data/snapshots/historical/
runtime_data/apparatus.lock

# --- Dumps (except boot-critical BUILD_REPORT.md) ---
Dumps/*
!Dumps/BUILD_REPORT.md
!Dumps/.gitkeep

# --- Session backups ---
backup_session/

# --- Runtime locks (keep .gitkeep) ---
MyTradingSys/runtime/locks/*
!MyTradingSys/runtime/locks/.gitkeep

# AV-triggered stubs - do not commit
Launch_alert.vbs
launch_alert.vbs

# --- Apparatus / MTS runtime churn (regenerated every cycle) ---
MyTradingSys/runtime/state_code.json
MyTradingSys/runtime/current_market_state.md
MyTradingSys/runtime/session_end_logs.md
MyTradingSys/system/session_end_logs.md
runtime_data/apparatus_log.txt
runtime_data/alert_counter.txt
runtime_data/last_alert.json
runtime_data/outcome_labels.json
runtime_data/_prob_label_enriched.json
runtime_data/speed_baselines/*.json
Dumps/SESSION_PASTE.txt

runtime_data/live_tape.md
runtime_data/last_tape_alert.json
runtime_data/mts-watch.log
runtime_data/mts-watch.out.txt
runtime_data/mts-watch.err.txt
runtime_data/tape-watch.out.txt
runtime_data/tape-watch.err.txt

# --- Klines cache (regenerated by Java each cycle) ---
MyTradingSys/market_data/klines/*.json

# --- Regime, supervisor log, supervisor lock (machine-local runtime) ---
MyTradingSys/runtime/state_code_regime.json
runtime_data/supervisor_log.txt
runtime_data/supervisor.lock
runtime_data/loop_stop.flag
runtime_data/supervisor_stop.flag
runtime_data/loop_state.json

# END
